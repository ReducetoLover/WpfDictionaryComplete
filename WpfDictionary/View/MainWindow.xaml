<Window x:Class="WpfDictionary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfDictionary"
        mc:Ignorable="d"
        Title="MainWindow" Height="680" Width="1200">
  <Grid Margin="0,0,0,-6">
    <DockPanel x:Name="PanelTop" VerticalAlignment="Top" Height="23">
      <Button x:Name="BtnLoadTables" HorizontalAlignment="Left" Content="Загрузить данные" Width="120" Margin="0,0,10,0" Click="BtnLoadTables_Click"/>
      <Button x:Name="BtnDeleteTables" HorizontalAlignment="Left" Content="Удалить данные" Width="120" Click="BtnDeleteTables_Click"/>

    </DockPanel>
    <DockPanel x:Name="PanelEmployees" LastChildFill="True" Margin="0,23,0,0">

      <Label VerticalAlignment="Top" HorizontalAlignment="Center" DockPanel.Dock="Top" x:Name="LblEmployees" Content="Автомобили" Width="150" HorizontalContentAlignment="Center" FontSize="20" FontStyle="Italic" FontWeight="Bold"/>
      <DockPanel x:Name="PanelSearch" DockPanel.Dock="Top" HorizontalAlignment="Left" LastChildFill="False" Width="1920" Margin="0,0,0,3">
        <Label HorizontalAlignment="Left"  x:Name="LblSearch" Content="Поиск:" Width="50" Margin="0,10,0,10"/>
        <TextBox x:Name="TxtBoxSearch" HorizontalAlignment="Left" TextWrapping="Wrap" Height="18" Width="300" TextChanged="TxtBoxSearch_TextChanged"/>
        <Button x:Name="BtnAddCar"  Content="Добавить" Width="150" Margin="10" Click="BtnAddCar_Click"/>
        <Button x:Name="BtnEditCar"  Content="Редактировать" Width="150" Margin="10" Click="BtnEditCar_Click"/>
        <Button x:Name="BtnDeleteCar"  Content="Удалить" Width="150" Margin="10" Click="BtnDeleteCar_Click"/>
      </DockPanel>
      <DataGrid CanUserDeleteRows="False" CanUserAddRows="False" AutoGenerateColumns="False" x:Name="Cars" ItemsSource="{Binding ListCars}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DockPanel.Dock="Bottom">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Марка" Binding="{Binding Make}"/>
          <DataGridTextColumn Header="Модель" Binding="{Binding Model}"/>
          <DataGridTextColumn Header="Пробег" Binding="{Binding Mileage}"/>
          <DataGridTextColumn Header="Дата производства" Binding="{Binding DateOfPurchase}"/>
          <DataGridTextColumn Header="В наличии?" Binding ="{Binding IsAvailable}"/>
        </DataGrid.Columns>
      </DataGrid>

    </DockPanel>

  </Grid>
</Window>
