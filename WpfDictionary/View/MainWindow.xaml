<Window x:Class="WpfDictionary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfDictionary"
        mc:Ignorable="d"
        Title="MainWindow" Height="680" Width="1200">
  <Grid Margin="0,0,0,-6">
    <DockPanel x:Name="PanelTop" VerticalAlignment="Top" Height="23">
      <Button x:Name="BtnLoadTables" HorizontalAlignment="Left" Content="Загрузить данные" Click ="LoadTables" Width="120"/>
      <Button x:Name="BtnDeleteTables" HorizontalAlignment="Left" Content="Удалить данные" Click="DeteleTables" Width="120"/>

    </DockPanel>
    <DockPanel x:Name="PanelOrganization" VerticalAlignment="Top" LastChildFill="True" Height="269" Margin="0,23,0,0">
      <Label DockPanel.Dock="Top" VerticalAlignment="Top" x:Name="LblOrg" Content="Организации" Width="150" HorizontalContentAlignment="Center" FontSize="20" FontStyle="Italic" FontWeight="Bold"/>
      <DockPanel DockPanel.Dock="Top" HorizontalAlignment="Left" LastChildFill="False" Width="1920" Margin="0,0,0,3">
        <Button x:Name="BtnAddOrg"  Content="Добавить организацию" Width="150" Click="BtnAddOrg_Click"/>
        <Button x:Name="BtnDeleteOrg"  Content="Удалить организацию" Click="BtnDeleteOrg_Click"
                />
      </DockPanel>
            <DataGrid CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False" x:Name="Cars" ItemsSource="{Binding ListOrg}" DockPanel.Dock="Top" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" SelectionChanged="Org_SelectionChanged" RowEditEnding="Org_RowEditEnding">
        <DataGrid.Columns>
          <DataGridTextColumn Visibility="Hidden" Header="Название организации" Binding="{Binding Id}"/>
          <DataGridTextColumn Header="Название организации" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
          <DataGridTextColumn IsReadOnly="True"  Header="Количество сотрудников" Binding="{Binding Model}"/>
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <DockPanel x:Name="PanelEmployees" LastChildFill="True" Margin="0,292,0,0">

      <Label VerticalAlignment="Top" HorizontalAlignment="Center" DockPanel.Dock="Top" x:Name="LblEmployees" Content="Сотрудники" Width="150" HorizontalContentAlignment="Center" FontSize="20" FontStyle="Italic" FontWeight="Bold"/>
      <DockPanel x:Name="PanelSearch" DockPanel.Dock="Top" HorizontalAlignment="Left" LastChildFill="False" Width="1920" Margin="0,0,0,3">
        <Label HorizontalAlignment="Left"  x:Name="LblSearch" Content="Поиск:" Width="50"/>
        <TextBox x:Name="TxtBoxSearch" HorizontalAlignment="Left" TextWrapping="Wrap" Height="18" Width="300" TextChanged="TxtBoxSearch_TextChanged"/>
        <Button x:Name="BtnAddEmpl"  Content="Добавить сотрудника" Width="150" Click="BtnAddEmpl_Click"/>
        <Button x:Name="BtnDeleteEmpl"  Content="Удалить сотрудника" Width="150" Click="BtnDeleteEmpl_Click"/>
      </DockPanel>
      <DataGrid CanUserDeleteRows="False" CanUserAddRows="False" AutoGenerateColumns="False" x:Name="Emp" ItemsSource="{Binding ListEmployees}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DockPanel.Dock="Bottom" RowEditEnding="Emp_RowEditEnding">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Фамилия" Binding="{Binding Surname,UpdateSourceTrigger=PropertyChanged}"/>
          <DataGridTextColumn Header="Имя" Binding="{Binding Name}"/>
          <DataGridTextColumn Header="Отчество" Binding="{Binding Middlename,UpdateSourceTrigger=PropertyChanged}"/>
          <DataGridTextColumn Header="Должность" Binding="{Binding Position,UpdateSourceTrigger=PropertyChanged}"/>
          <DataGridTemplateColumn Header="Фото" Width="80">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Image Height="80" Width="80" Source="{Binding Image,UpdateSourceTrigger=PropertyChanged}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>

        </DataGrid.Columns>
      </DataGrid>

    </DockPanel>

  </Grid>
</Window>
